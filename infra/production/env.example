# YuCampus production settings. Copy to .env in this folder (cp env.example .env) and fill in every value.
# .env is never committed. Make random values with:  openssl rand -hex 32
# Everything else (database addresses, storage address, NODE_ENV ...) is set in docker-compose.yml.

# ------------------------------------------------------------------ Address
ROOT_DOMAIN=yucampus.yubhiantechnologies.in
# Let's Encrypt writes here about certificate problems.
ACME_EMAIL=

# ------------------------------------------------------------------ Database (random hex values)
# Owner of the database: used only for migrations, rules and team accounts.
POSTGRES_PASSWORD=
# What the API connects as (row-level security applies). Read only when the database is first created.
APP_DB_PASSWORD=

# ------------------------------------------------------------------ File storage (random hex values)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ------------------------------------------------------------------ Sign-in (random hex values)
# Signs sign-in tokens. Changing it signs everyone out.
JWT_SECRET=
# Encrypts the team's authenticator secrets. Changing it means every team member sets up their authenticator again.
TOTP_KEY=

# ------------------------------------------------------------------ Email
# Your sending service's SMTP address, e.g. Amazon SES Mumbai:
#   smtps://SMTP_USERNAME:SMTP_PASSWORD@email-smtp.ap-south-1.amazonaws.com:465
SMTP_URL=
MAIL_FROM="YuCampus <no-reply@yubhiantechnologies.in>"

# ------------------------------------------------------------------ Sign-in with Google or Microsoft (optional)
# Same values as on your laptop. Add the live redirect addresses first (docs/SSO_SETUP.md, part B).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
