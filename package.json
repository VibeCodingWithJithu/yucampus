{
  "name": "yucampus",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @yucampus/api db:migrate",
    "db:seed": "pnpm --filter @yucampus/api db:seed",
    "rules:import": "pnpm --filter @yucampus/api rules:import",
    "platform:create-admin": "pnpm --filter @yucampus/api platform:create-admin"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
