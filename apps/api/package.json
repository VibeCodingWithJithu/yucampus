{
  "name": "@yucampus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:rules": "tsx --env-file-if-exists=../../.env prisma/seed-rules.ts",
    "rules:import": "tsx --env-file-if-exists=../../.env scripts/import-rules.ts",
    "platform:create-admin": "tsx --env-file-if-exists=../../.env scripts/create-platform-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@electric-sql/pglite": "^0.5.9",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@yucampus/types": "workspace:*",
    "@yucampus/validation": "workspace:*",
    "archiver": "8.0.0",
    "bullmq": "6.3.10",
    "docx": "9.8.1",
    "exceljs": "4.4.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "10.0.13",
    "pdfkit": "0.20.2",
    "pglite-prisma-adapter": "^0.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "0.17.6",
    "@yucampus/config": "workspace:*",
    "fflate": "0.7.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
