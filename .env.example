# YuCampus environment variables.
#
# Local development with Docker: copy this file to .env (repository root), run `pnpm infra:up`, then
# `pnpm db:migrate`, `pnpm db:seed` and `pnpm dev`. The values below match infra/docker-compose.yml
# (PostgreSQL, Redis, and SeaweedFS as the local S3-compatible file store).
#
# Local development WITHOUT Docker: do not create a .env at all. The API then uses its built-in local
# database (PGlite in apps/api/.data) and needs nothing else.
#
# NEVER commit a real .env. Pilot and production secrets live in the host's secret store, not in git.
# All app data (database, files, backups) must stay in India - see docs/ARCHITECTURE.md.

# ------------------------------------------------------------------ Database (standard PostgreSQL)
# Owner role: only for migrations and seeding. It is NOT subject to row-level security.
DATABASE_MIGRATE_URL=postgresql://yucampus:yucampus@localhost:5432/yucampus
# App role: what the API connects as at runtime. Row-level security applies to it.
# The migrations create the role without a password; set one on the server (ALTER ROLE ... PASSWORD).
DATABASE_URL=postgresql://yucampus_app:yucampus_app@localhost:5432/yucampus

# ------------------------------------------------------------------ Jobs and cache
# Background jobs (reminders, emails). Without it, jobs run inside the API process (fine for local work).
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------ File storage (any S3-compatible service)
# Changing provider is only these five values. Examples (bucket must be in an Indian region):
#   Local (Docker):     S3_ENDPOINT=http://localhost:9000                              S3_REGION=ap-south-1
#   AWS Mumbai:         S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com                S3_REGION=ap-south-1
#   AWS Hyderabad:      S3_ENDPOINT=https://s3.ap-south-2.amazonaws.com                S3_REGION=ap-south-2
#   Oracle (Mumbai):    S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com  S3_REGION=ap-mumbai-1
#   Supabase (Mumbai):  S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3        S3_REGION=ap-south-1
#   Google (Mumbai):    S3_ENDPOINT=https://storage.googleapis.com (HMAC keys)          S3_REGION=asia-south1
# Not allowed: Cloudflare R2, Zoho WorkDrive/Catalyst, or anything that cannot keep data in India.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=yucampus-evidence
S3_ACCESS_KEY=yucampus
S3_SECRET_KEY=yucampus-local-secret
# Web addresses browsers may upload from, straight to storage (the bucket's CORS rule), comma-separated.
# Locally this is set on the bucket automatically. In pilot and production set the same rule on the bucket
# by hand: every college has its own subdomain, so use a wildcard.
# UPLOAD_ORIGINS=https://*.yucampus.yubhiantechnologies.in

# ------------------------------------------------------------------ API and web
API_PORT=4000
# The web app's address; the API only accepts browser calls from here.
WEB_ORIGIN=http://localhost:3000
# Where the web app forwards /api/v1 requests (read when the web app starts or is built).
API_PROXY_TARGET=http://localhost:4000

# ------------------------------------------------------------------ Email
# Locally: the Mailpit test inbox from docker-compose (read mail at http://localhost:8025).
# Pilot/production: your provider's SMTP, e.g. smtps://user:password@smtp.example.com:465
# Without SMTP_URL, emails are only printed in the API console.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="YuCampus <no-reply@yubhiantechnologies.in>"

# ------------------------------------------------------------------ Links in emails
# Production: each college is <subdomain>.ROOT_DOMAIN. Locally, links point to WEB_ORIGIN.
# ROOT_DOMAIN=yucampus.yubhiantechnologies.in

# ------------------------------------------------------------------ Sign-in
# Signs sign-in tokens. In pilot and production: a long random value, at least 32 characters.
JWT_SECRET=local-development-secret-change-me-in-production
# Encrypts the YuCampus team's authenticator-app secrets. Optional: falls back to JWT_SECRET. Changing it means
# every team member sets up their authenticator again.
# TOTP_KEY=

# ------------------------------------------------------------------ Sign-in with Google or Microsoft (optional)
# Register one app with each provider. Redirect address: <SSO_BASE_URL>/api/v1/auth/sso/<google|microsoft>/callback
# Without these the buttons do not appear. Each college still turns SSO on and lists its domains in Institution setup.
# SSO_BASE_URL=https://auth.yucampus.yubhiantechnologies.in   (default: WEB_ORIGIN locally, https://auth.ROOT_DOMAIN in production)
# The web app's copy of the same address, used by the sign-in buttons (set at build time; leave empty locally).
# NEXT_PUBLIC_SSO_URL=https://auth.yucampus.yubhiantechnologies.in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
